CONTROL_DATABASE_URL=postgres://control:control@127.0.0.1:5432/control?sslmode=disable
# Required: standard-base64 encoding of 32 random bytes. Keep the same key for
# every replica/restart using this database; store it outside the repository.
CONTROL_PROFILE_CREDENTIAL_KEY=
# Comma-separated exact lowercase hosts accepted by Deployment compilation.
# Configure every model, MCP, knowledge, and storage destination used by a Profile.
CONTROL_DEPLOYMENT_ALLOWED_ENDPOINT_HOSTS=api.openai.com,mcp.example.com,qdrant.internal,state.example.test
# Required release-pinned digest for exactly the hosts above and the frozen V1 contract.
# Recompute once during release preparation with -print-deployment-contract-digest
# if hosts or the binary contract change; persist the same expected value for every replica.
CONTROL_DEPLOYMENT_EXPECTED_CONTRACT_DIGEST=sha256:43d9ac6291cf7ccacf544cb122fa4d92b398317fa6020e4bba43e8666e8747b0
CONTROL_HTTP_ADDRESS=:8080
CONTROL_SESSION_LIFETIME=24h
CONTROL_SESSION_COOKIE_NAME=control_session
CONTROL_SESSION_COOKIE_SECURE=false
CONTROL_BOOTSTRAP_MODE=auto
CONTROL_BOOTSTRAP_USERNAME=platform-admin
CONTROL_BOOTSTRAP_DISPLAY_NAME=Platform Operator
CONTROL_BOOTSTRAP_PASSWORD=admin1234567

# Channel Gateway / JetStream. Inject unique values; none are generated by startup.
# DSN password must be URL-encoded; use the dedicated gateway role/database.
GATEWAY_POSTGRES_PASSWORD=
GATEWAY_DATABASE_URL=
NATS_GATEWAY_PASSWORD=
NATS_CONTROL_PASSWORD=
NATS_RECONCILER_PASSWORD=
# Empty accounts file allows startup with no bot configured. Account secrets are
# environment references; do not place real token/secret values in JSON.
GATEWAY_TELEGRAM_ACCOUNTS_FILE=
GATEWAY_TELEGRAM_WEBHOOK_SECRET=

# WeCom account projection directory is mounted, so atomic file replacement is visible.
# The default deployment file is empty; no real Bot credentials are in this repo.
GATEWAY_WECOM_ACCOUNTS_DIR=./wecom
GATEWAY_WECOM_BOT_SECRET=
# Optional stable instance identifier; omitted generates a process-unique identifier.

# Gateway Control-backed production source (SDK credentials are resolved via mTLS).
# Instance identity must match the Control principal and be unique per live replica.
GATEWAY_ACCOUNT_SOURCE=control
GATEWAY_INSTANCE_ID=gateway-1
GATEWAY_CONTROL_URL=
GATEWAY_CONTROL_SCOPE_ID=
GATEWAY_CONTROL_SOURCE_EPOCH=
GATEWAY_PUBLIC_ORIGIN=
# Directory contains ca.pem, client.pem and client-key.pem; private key mode 0600.
GATEWAY_CONTROL_CERTS_DIR=
