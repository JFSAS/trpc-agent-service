{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/deployment/v1/runtime-manifest.schema.json",
  "title": "RuntimeManifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "tenant_id",
    "deployment_id",
    "deployment_revision_id",
    "revision_number",
    "published_at",
    "content_digest",
    "content"
  ],
  "properties": {
    "manifest_id": {"$ref": "#/$defs/opaque_id"},
    "tenant_id": {"$ref": "#/$defs/opaque_id"},
    "deployment_id": {"$ref": "#/$defs/opaque_id"},
    "deployment_revision_id": {"$ref": "#/$defs/opaque_id"},
    "revision_number": {"type": "integer", "minimum": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "content_digest": {"$ref": "#/$defs/digest"},
    "content": {"$ref": "#/$defs/content"}
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "resource_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "credential_id": {
      "type": "string",
      "pattern": "^crd_[0-9a-f]{32}$"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "compiler_version",
        "runtime_contract_version",
        "platform_contract",
        "tenant_id",
        "sources",
        "agent_plan",
        "resources",
        "resolved_requirements",
        "storage_roles",
        "execution"
      ],
      "properties": {
        "schema_version": {"const": "v1"},
        "compiler_version": {"const": "deployment-compiler-v1"},
        "runtime_contract_version": {"const": "worker-manifest-v1"},
        "platform_contract": {"$ref": "#/$defs/platform_contract"},
        "tenant_id": {"$ref": "#/$defs/opaque_id"},
        "sources": {"$ref": "#/$defs/sources"},
        "agent_plan": {"$ref": "#/$defs/agent_plan"},
        "resources": {"$ref": "#/$defs/resources"},
        "resolved_requirements": {"$ref": "#/$defs/resolved_requirements"},
        "storage_roles": {"$ref": "#/$defs/storage_roles"},
        "execution": {"$ref": "#/$defs/execution"}
      }
    },
    "platform_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": {"enum": ["platform-v1", "worker-v1"]},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "profile"],
      "properties": {
        "agent": {"$ref": "#/$defs/agent_source"},
        "profile": {"$ref": "#/$defs/profile_source"}
      }
    },
    "agent_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "version_number", "version_id", "schema_version", "digest"],
      "properties": {
        "agent_id": {"$ref": "#/$defs/opaque_id"},
        "version_number": {"type": "integer", "minimum": 1},
        "version_id": {"$ref": "#/$defs/opaque_id"},
        "schema_version": {"const": "v1"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "profile_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "revision_number", "revision_id", "schema_version", "digest"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/opaque_id"},
        "revision_number": {"type": "integer", "minimum": 1},
        "revision_id": {"$ref": "#/$defs/opaque_id"},
        "schema_version": {"const": "v1"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "agent_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "nodes"],
      "properties": {
        "root": {"$ref": "#/$defs/resource_key"},
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "propertyNames": {"$ref": "#/$defs/resource_key"},
          "additionalProperties": {"$ref": "#/$defs/node"}
        }
      }
    },
    "node": {
      "oneOf": [
        {"$ref": "#/$defs/llm_node"},
        {"$ref": "#/$defs/sequence_node"},
        {"$ref": "#/$defs/parallel_node"},
        {"$ref": "#/$defs/loop_node"}
      ]
    },
    "llm_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instruction",
        "model_resource",
        "tool_resources",
        "knowledge_resources",
        "callable_entries"
      ],
      "properties": {
        "kind": {"const": "llm"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 65536},
        "model_resource": {"$ref": "#/$defs/resource_key"},
        "tool_resources": {"$ref": "#/$defs/resource_key_set"},
        "knowledge_resources": {"$ref": "#/$defs/resource_key_set"},
        "callable_entries": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "generation": {"$ref": "#/$defs/generation"}
      }
    },
    "sequence_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "children"],
      "properties": {
        "kind": {"const": "sequence"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "children": {"$ref": "#/$defs/children"}
      }
    },
    "parallel_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "children"],
      "properties": {
        "kind": {"const": "parallel"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "children": {"$ref": "#/$defs/children"}
      }
    },
    "loop_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "body", "max_iterations"],
      "properties": {
        "kind": {"const": "loop"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "body": {"$ref": "#/$defs/resource_key"},
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/resource_key"}
    },
    "resource_key_set": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/resource_key"}
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 262144}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "tools", "knowledge", "storage"],
      "properties": {
        "models": {"$ref": "#/$defs/model_resources"},
        "tools": {"$ref": "#/$defs/tool_resources"},
        "knowledge": {"$ref": "#/$defs/knowledge_resources"},
        "storage": {"$ref": "#/$defs/storage_resources"}
      }
    },
    "model_resources": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"$ref": "#/$defs/resource_key"},
      "additionalProperties": {"$ref": "#/$defs/model_resource"}
    },
    "tool_resources": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/resource_key"},
      "additionalProperties": {"$ref": "#/$defs/tool_resource"}
    },
    "knowledge_resources": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/resource_key"},
      "additionalProperties": {"$ref": "#/$defs/knowledge_resource"}
    },
    "storage_resources": {
      "type": "object",
      "required": ["session"],
      "maxProperties": 2,
      "propertyNames": {"enum": ["session", "memory"]},
      "additionalProperties": {"$ref": "#/$defs/storage_resource"}
    },
    "model_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_version", "kind", "model", "base_url", "credential", "capabilities"],
      "properties": {
        "adapter_version": {"const": "openai-compatible-v1"},
        "kind": {"const": "openai_compatible"},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "base_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "credential": {"$ref": "#/$defs/api_key_credential"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["chat", "tool_call"]}
        }
      }
    },
    "tool_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_version", "kind", "server_url", "toolset_name", "tool_name", "auth", "capability"],
      "properties": {
        "adapter_version": {"const": "mcp-web-search-v1"},
        "kind": {"const": "mcp_streamable_http"},
        "server_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "toolset_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "tool_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "auth": {"$ref": "#/$defs/tool_auth"},
        "capability": {"const": "web.search"}
      }
    },
    "tool_auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "none"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "credential"],
          "properties": {
            "kind": {"const": "bearer"},
            "credential": {"$ref": "#/$defs/bearer_token_credential"}
          }
        }
      ]
    },
    "knowledge_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_version", "kind", "host", "port", "tls", "collection", "embedding", "capability"],
      "properties": {
        "adapter_version": {"const": "qdrant-openai-v1"},
        "kind": {"const": "qdrant_openai"},
        "host": {"type": "string", "minLength": 1, "maxLength": 253},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "tls": {"type": "boolean"},
        "collection": {"type": "string", "minLength": 1, "maxLength": 256},
        "credential": {"$ref": "#/$defs/qdrant_api_key_credential"},
        "embedding": {"$ref": "#/$defs/embedding_resource"},
        "capability": {"const": "knowledge.search"}
      }
    },
    "embedding_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "base_url", "dimensions", "credential"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "base_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "dimensions": {"type": "integer", "minimum": 1},
        "credential": {"$ref": "#/$defs/embedding_api_key_credential"}
      }
    },
    "storage_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_version", "kind", "destination", "credential"],
      "properties": {
        "adapter_version": {"const": "postgres-state-v1"},
        "kind": {"const": "postgres_state"},
        "destination": {"$ref": "#/$defs/storage_destination"},
        "credential": {"$ref": "#/$defs/dsn_credential"}
      }
    },
    "storage_destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "database", "username", "sslmode"],
      "properties": {
        "host": {"type": "string", "minLength": 1, "maxLength": 253},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "database": {"type": "string", "minLength": 1, "maxLength": 128},
        "username": {"type": "string", "minLength": 1, "maxLength": 128},
        "sslmode": {"enum": ["disable", "require", "verify-full"]}
      }
    },
    "api_key_credential": {
      "$ref": "#/$defs/credential_descriptor",
      "properties": {"purpose": {"const": "api_key"}}
    },
    "bearer_token_credential": {
      "$ref": "#/$defs/credential_descriptor",
      "properties": {"purpose": {"const": "bearer_token"}}
    },
    "qdrant_api_key_credential": {
      "$ref": "#/$defs/credential_descriptor",
      "properties": {"purpose": {"const": "qdrant_api_key"}}
    },
    "embedding_api_key_credential": {
      "$ref": "#/$defs/credential_descriptor",
      "properties": {"purpose": {"const": "embedding_api_key"}}
    },
    "dsn_credential": {
      "$ref": "#/$defs/credential_descriptor",
      "properties": {"purpose": {"const": "dsn"}}
    },
    "credential_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_id", "purpose", "audience_digest"],
      "properties": {
        "credential_id": {"$ref": "#/$defs/credential_id"},
        "purpose": {"enum": ["api_key", "bearer_token", "qdrant_api_key", "embedding_api_key", "dsn"]},
        "audience_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "resolved_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "tools", "knowledge"],
      "properties": {
        "models": {"$ref": "#/$defs/resolved_map"},
        "tools": {"$ref": "#/$defs/resolved_map"},
        "knowledge": {"$ref": "#/$defs/resolved_map"}
      }
    },
    "resolved_map": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/resource_key"},
      "additionalProperties": {"$ref": "#/$defs/resource_key"}
    },
    "storage_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session"],
      "properties": {
        "session": {"const": "session"},
        "memory": {"const": "memory"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "allowed_endpoint_hosts", "max_run_seconds", "max_tool_calls", "max_output_tokens"],
      "properties": {
        "backend": {"const": "worker-process-v1"},
        "allowed_endpoint_hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 253}
        },
        "max_run_seconds": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1}
      }
    }
  }
}
