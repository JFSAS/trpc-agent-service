{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/runtimeprofile/v1/runtime-profile-spec.schema.json",
  "title": "RuntimeProfileSpec V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models", "tools", "knowledge", "storage"],
  "properties": {
    "schema_version": {"const": "v1"},
    "models": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"$ref": "#/$defs/resource_key"},
      "additionalProperties": {"$ref": "#/$defs/model_resource"}
    },
    "tools": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/resource_key"},
      "additionalProperties": {"$ref": "#/$defs/tool_resource"}
    },
    "knowledge": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/resource_key"},
      "additionalProperties": {"$ref": "#/$defs/knowledge_resource"}
    },
    "storage": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"$ref": "#/$defs/resource_key"},
      "additionalProperties": {"$ref": "#/$defs/storage_resource"}
    }
  },
  "$defs": {
    "resource_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "secret_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "tool_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "model_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "collection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_resource": {
      "oneOf": [
        {"$ref": "#/$defs/openai_compatible_model"}
      ]
    },
    "openai_compatible_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model", "base_url", "api_key_ref", "capabilities"],
      "properties": {
        "kind": {"const": "openai_compatible"},
        "model": {"$ref": "#/$defs/model_name"},
        "base_url": {"$ref": "#/$defs/uri"},
        "api_key_ref": {"$ref": "#/$defs/secret_ref"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["chat", "tool_call"]
          }
        }
      }
    },
    "tool_resource": {
      "oneOf": [
        {"$ref": "#/$defs/mcp_streamable_http_tool"}
      ]
    },
    "mcp_streamable_http_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "server_url",
        "toolset_name",
        "tool_name",
        "auth",
        "capability"
      ],
      "properties": {
        "kind": {"const": "mcp_streamable_http"},
        "server_url": {"$ref": "#/$defs/uri"},
        "toolset_name": {"$ref": "#/$defs/tool_name"},
        "tool_name": {"$ref": "#/$defs/tool_name"},
        "auth": {"$ref": "#/$defs/tool_auth"},
        "capability": {"const": "web.search"}
      }
    },
    "tool_auth": {
      "oneOf": [
        {"$ref": "#/$defs/no_auth"},
        {"$ref": "#/$defs/bearer_auth"}
      ]
    },
    "no_auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "none"}
      }
    },
    "bearer_auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "secret_ref"],
      "properties": {
        "kind": {"const": "bearer"},
        "secret_ref": {"$ref": "#/$defs/secret_ref"}
      }
    },
    "knowledge_resource": {
      "oneOf": [
        {"$ref": "#/$defs/qdrant_openai_knowledge"}
      ]
    },
    "qdrant_openai_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "host", "port", "tls", "collection", "embedding"],
      "properties": {
        "kind": {"const": "qdrant_openai"},
        "host": {"$ref": "#/$defs/host"},
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "tls": {"type": "boolean"},
        "collection": {"$ref": "#/$defs/collection"},
        "qdrant_api_key_ref": {"$ref": "#/$defs/secret_ref"},
        "embedding": {"$ref": "#/$defs/openai_embedding"}
      }
    },
    "openai_embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "base_url", "api_key_ref", "dimensions"],
      "properties": {
        "model": {"$ref": "#/$defs/model_name"},
        "base_url": {"$ref": "#/$defs/uri"},
        "api_key_ref": {"$ref": "#/$defs/secret_ref"},
        "dimensions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      }
    },
    "storage_resource": {
      "oneOf": [
        {"$ref": "#/$defs/postgres_state_storage"}
      ]
    },
    "postgres_state_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dsn_ref"],
      "properties": {
        "kind": {"const": "postgres_state"},
        "dsn_ref": {"$ref": "#/$defs/secret_ref"}
      }
    }
  }
}
