{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/channel/v1/policy-definition-event.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "event_type": {
          "const": "channel.policy_definition.published.v1",
          "type": "string"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_kind": {
          "enum": [
            "session",
            "quota"
          ]
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "minLength": 71,
          "maxLength": 71
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "tenant_id",
        "occurred_at",
        "policy_kind",
        "policy_id",
        "revision",
        "digest"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "event_type": {
          "const": "channel.policy_definition.audit.v1",
          "type": "string"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_kind": {
          "enum": [
            "session",
            "quota"
          ]
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "minLength": 71,
          "maxLength": 71
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "actor_kind": {
          "const": "CONTROL_USER",
          "type": "string"
        },
        "action": {
          "const": "channel.policy_definition.publish",
          "type": "string"
        },
        "decision": {
          "const": "PUBLISHED",
          "type": "string"
        },
        "reason_code": {
          "const": "OWNER_POLICY_PUBLICATION",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "tenant_id",
        "occurred_at",
        "policy_kind",
        "policy_id",
        "revision",
        "digest",
        "actor_id",
        "actor_kind",
        "action",
        "decision",
        "reason_code"
      ]
    }
  ]
}
