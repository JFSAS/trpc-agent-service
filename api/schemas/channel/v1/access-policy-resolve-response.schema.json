{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/channel/v1/access-policy-resolve-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "source_epoch": {
      "type": "string",
      "format": "uuid"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "provider": {
          "enum": [
            "telegram",
            "wecom"
          ]
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "access_mode": {
              "enum": [
                "DENY_ALL",
                "ALLOWLIST",
                "PUBLIC_LIMITED"
              ]
            },
            "allowed_principal_ids": {
              "type": "array",
              "maxItems": 4096,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "not": {
                  "pattern": "[^A-Za-z0-9._:-]"
                }
              }
            },
            "allowed_conversation_ids": {
              "type": "array",
              "maxItems": 4096,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "allowed_operations": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "message.send",
                  "session.new",
                  "run.cancel_own"
                ]
              }
            },
            "session_policy": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "not": {
                        "pattern": "[^A-Za-z0-9._:-]"
                      }
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$",
                      "minLength": 71,
                      "maxLength": 71
                    }
                  },
                  "required": [
                    "id",
                    "revision",
                    "digest"
                  ]
                },
                {
                  "const": {
                    "id": "",
                    "revision": 0,
                    "digest": ""
                  }
                }
              ]
            },
            "tenant_quota_ref": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "not": {
                        "pattern": "[^A-Za-z0-9._:-]"
                      }
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$",
                      "minLength": 71,
                      "maxLength": 71
                    }
                  },
                  "required": [
                    "id",
                    "revision",
                    "digest"
                  ]
                },
                {
                  "const": {
                    "id": "",
                    "revision": 0,
                    "digest": ""
                  }
                }
              ]
            },
            "authorization_max_age_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000
            }
          },
          "required": [
            "access_mode",
            "allowed_principal_ids",
            "allowed_conversation_ids",
            "allowed_operations",
            "session_policy",
            "tenant_quota_ref",
            "authorization_max_age_ms"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "access_mode": {
                    "const": "DENY_ALL"
                  }
                }
              },
              "then": {
                "properties": {
                  "allowed_principal_ids": {
                    "maxItems": 0
                  },
                  "allowed_conversation_ids": {
                    "maxItems": 0
                  },
                  "allowed_operations": {
                    "maxItems": 0
                  },
                  "session_policy": {
                    "const": {
                      "id": "",
                      "revision": 0,
                      "digest": ""
                    }
                  },
                  "tenant_quota_ref": {
                    "const": {
                      "id": "",
                      "revision": 0,
                      "digest": ""
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "session_policy": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "not": {
                          "pattern": "[^A-Za-z0-9._:-]"
                        }
                      },
                      "revision": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$",
                        "minLength": 71,
                        "maxLength": 71
                      }
                    },
                    "required": [
                      "id",
                      "revision",
                      "digest"
                    ]
                  },
                  "tenant_quota_ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "not": {
                          "pattern": "[^A-Za-z0-9._:-]"
                        }
                      },
                      "revision": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$",
                        "minLength": 71,
                        "maxLength": 71
                      }
                    },
                    "required": [
                      "id",
                      "revision",
                      "digest"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "access_mode": {
                    "const": "PUBLIC_LIMITED"
                  }
                }
              },
              "then": {
                "properties": {
                  "allowed_principal_ids": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        },
        "published_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "minLength": 71,
          "maxLength": 71
        }
      },
      "required": [
        "schema_version",
        "tenant_id",
        "account_id",
        "provider",
        "policy_id",
        "revision",
        "body",
        "published_by",
        "published_at",
        "digest"
      ]
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "source_epoch",
    "policy"
  ]
}
