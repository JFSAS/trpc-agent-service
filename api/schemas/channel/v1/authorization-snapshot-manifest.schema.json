{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/channel/v1/authorization-snapshot-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "source_epoch": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "account_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "provider": {
      "enum": [
        "telegram",
        "wecom"
      ]
    },
    "generation": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "account_revision": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "account_enabled": {
      "type": "boolean"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "minLength": 71,
          "maxLength": 71
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorization_max_age_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "principal_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "principal_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "source_epoch",
    "tenant_id",
    "account_id",
    "provider",
    "generation",
    "account_revision",
    "account_enabled",
    "policy",
    "captured_at",
    "authorization_max_age_ms",
    "principal_count",
    "principal_digest"
  ]
}
