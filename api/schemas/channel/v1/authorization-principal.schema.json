{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/channel/v1/authorization-principal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "principal_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "external_user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "state": {
      "enum": [
        "ACTIVE",
        "REVOKED"
      ]
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/version"
    }
  },
  "required": [
    "principal_id",
    "external_user_id",
    "state",
    "revision"
  ]
}
