{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/channel/v1/principal-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "expected_principal_revision": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "state": {
      "enum": [
        "ACTIVE",
        "REVOKED"
      ]
    }
  },
  "required": [
    "account_id",
    "expected_principal_revision",
    "state"
  ]
}
