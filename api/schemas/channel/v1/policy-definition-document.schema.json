{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "published_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "kind": {
      "enum": [
        "session",
        "quota"
      ]
    },
    "definition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "session": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "partition": {
                  "enum": [
                    "per_user_in_conversation",
                    "shared_conversation"
                  ]
                }
              },
              "required": [
                "partition"
              ]
            }
          },
          "required": [
            "enabled",
            "session"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "quota": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "public_limited": {
                  "type": "boolean"
                },
                "max_concurrent_runs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max_runs_per_minute": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max_total_model_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Cumulative tenant model-token cap across policy revisions; absent means unconfigured, zero denies new consumption. Not a price or a per-call bound."
                }
              },
              "required": [
                "public_limited",
                "max_concurrent_runs",
                "max_runs_per_minute"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "public_limited": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "max_concurrent_runs": {
                        "minimum": 1
                      },
                      "max_runs_per_minute": {
                        "minimum": 1
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "enabled",
            "quota"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "policy_id",
    "revision",
    "published_by",
    "published_at",
    "digest",
    "kind",
    "definition"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/channel/v1/policy-definition-document.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session"
          }
        }
      },
      "then": {
        "properties": {
          "definition": {
            "required": [
              "session"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "definition": {
            "required": [
              "quota"
            ]
          }
        }
      }
    }
  ]
}
