{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/channel/v1/policy-definition-publish.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "definition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "session": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "partition": {
                  "enum": [
                    "per_user_in_conversation",
                    "shared_conversation"
                  ]
                }
              },
              "required": [
                "partition"
              ]
            }
          },
          "required": [
            "enabled",
            "session"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "quota": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "public_limited": {
                  "type": "boolean"
                },
                "max_concurrent_runs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max_runs_per_minute": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max_total_model_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Cumulative tenant model-token cap across policy revisions; absent means unconfigured, zero denies new consumption. Not a price or a per-call bound."
                }
              },
              "required": [
                "public_limited",
                "max_concurrent_runs",
                "max_runs_per_minute"
              ]
            }
          },
          "required": [
            "enabled",
            "quota"
          ]
        }
      ]
    }
  },
  "required": [
    "expected_revision",
    "definition"
  ]
}
